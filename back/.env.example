# Confirm that this matches the timestamps in the turbine CSV files.
TURBINE_TIMEZONE=Asia/Almaty

# Relative paths resolve from back/, regardless of the launch directory.
TICKETS_DIR=../tickets
# Embedded worker starts automatically with the backend. Set false for a separate worker process.
INFERENCE_ENABLED=true
INFERENCE_MODEL_DIR=../inference/models
INFERENCE_WORKERS=2
INFERENCE_THREADS=1
DATASETS_DIR=./data
WEATHER_CACHE_DIR=./.cache/weather
# Backend/ML configuration only. Never sent by frontend. 6 = every 10 minutes.
ML_STEP=6
WEATHER_MODEL=gfs_global
# false: use online weather for the horizon even when dataset weather exists.
USE_DATASET_FOR_HORIZON=true
# Fill old missing context AND horizon weather with ERA5 reanalysis.
# For forecast-only backtests, set both USE_DATASET_FOR_HORIZON and this to false.
USE_HISTORICAL_WEATHER=true
# Match the meteorological predictor height with your ML teammate.
WEATHER_WIND_VARIABLE=wind_speed_100m
# Conservative replay policy, not exact per-run publication metadata.
FORECAST_AVAILABILITY_MARGIN_HOURS=12
WEATHER_TIMEOUT_SECONDS=25
TICKET_TIMEOUT_SECONDS=1800
RESULT_TTL_SECONDS=1800
MAX_ACTIVE_TICKETS=32
CORS_ORIGINS=*
