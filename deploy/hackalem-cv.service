[Unit]
Description=hackalem cv
After=network.target

[Service]
User=azureuser
WorkingDirectory=/data/app
EnvironmentFile=-/data/app/.env
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=3
# --host 127.0.0.1 keeps the app unreachable from the internet; only Caddy may reach it.
ExecStart=/data/app/.venv/bin/uvicorn cv.server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
